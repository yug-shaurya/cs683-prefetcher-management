diff --git a/config/util.py b/config/util.py
index 072641cd..555e95aa 100644
--- a/config/util.py
+++ b/config/util.py
@@ -75,6 +75,16 @@ def chain(*dicts):
 
     return functools.reduce(merge_dicts, dicts, {})
 
+def unique_by(key, iterable):
+    ''' Order-preserving dedupe of dicts by the given key.
+    util.chain() concatenates list values on merge, so a module list in the
+    config is repeated once per merge pass. The config means "use these
+    modules", not "accumulate them". '''
+    seen = {}
+    for item in iterable:
+        seen.setdefault(item.get(key), item)
+    return list(seen.values())
+
